{
  "compilerOptions": {
    "outDir": "./dist/",
    "noImplicitAny": true,
    "module": "Node16",
    "target": "ES2020",
    "jsx": "react",
    "allowJs": true,
    "allowSyntheticDefaultImports": true,
    "moduleResolution": "Node16",
    "useDefineForClassFields": false,
    "experimentalDecorators": true,
    "skipLibCheck": true,
  },
  "exclude": [
    "./vendor",
  ]
}